{{ 'lectopolis-flip.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lectopolis-flip.js' | asset_url }}" defer></script>
{%- liquid
  assign slides = section.blocks | where: 'type', 'slide'
  assign slide_count = 0
  for block in slides
    if block.settings.image != blank
      assign slide_count = slide_count | plus: 1
    endif
  endfor
  assign first_ratio = 2.0
  for block in slides
    if block.settings.image != blank
      assign first_ratio = block.settings.image.aspect_ratio
      break
    endif
  endfor
  assign mobile_ratio = 1.6
  for block in slides
    if block.settings.image != blank
      assign mobile_ratio = block.settings.mobile_image.aspect_ratio | default: first_ratio
      break
    endif
  endfor
  assign default_alt = 'Selección de la librería Lectópolis'
-%}
<section
  class="lp-flip"
  {% if slide_count > 1 %}aria-roledescription="carrusel"{% endif %}
  aria-label="{{ section.settings.label | default: 'Banners de Lectópolis' | escape }}"
  data-lp-flip
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.interval | times: 1000 }}"
  data-duration="{{ section.settings.duration | times: 100 }}"
  style="--lp-flip-ratio:{{ first_ratio }};--lp-flip-ratio-mobile:{{ mobile_ratio }};--lp-flip-duration:{{ section.settings.duration | times: 100 }}ms"
>
  <div class="lp-flip__book" data-lp-flip-book>
    {%- if slide_count > 0 -%}
      {%- assign index = 0 -%}
      {%- for block in slides -%}
        {%- if block.settings.image == blank -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign alt = block.settings.image.alt | default: block.settings.alt | default: default_alt
          if block.settings.alt != blank
            assign alt = block.settings.alt
          endif
          assign is_first = false
          if index == 0
            assign is_first = true
          endif
        -%}
        <div
          class="lp-flip__slide{% if is_first %} is-active{% endif %}"
          role="group"
          aria-roledescription="diapositiva"
          aria-label="{{ index | plus: 1 }} de {{ slide_count }}"
          {% unless is_first %}aria-hidden="true" inert{% endunless %}
          data-lp-flip-slide
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="lp-flip__link"{% unless is_first %} tabindex="-1"{% endunless %}>{%- endif -%}
          <picture>
            {%- if block.settings.mobile_image != blank -%}
              <source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 500 }} 500w, {{ block.settings.mobile_image | image_url: width: 750 }} 750w, {{ block.settings.mobile_image | image_url: width: 1100 }} 1100w" sizes="100vw">
            {%- endif -%}
            {%- if is_first -%}
              {{ block.settings.image | image_url: width: 2400 | image_tag: widths: '750,1100,1600,2000,2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: alt, class: 'lp-flip__img' }}
            {%- else -%}
              {{ block.settings.image | image_url: width: 2400 | image_tag: widths: '750,1100,1600,2000,2400', sizes: '100vw', loading: 'lazy', alt: alt, class: 'lp-flip__img' }}
            {%- endif -%}
          </picture>
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </div>
        {%- assign index = index | plus: 1 -%}
      {%- endfor -%}
    {%- else -%}
      <div class="lp-flip__slide is-active" data-lp-flip-slide>
        <a href="{{ routes.all_products_collection_url }}" class="lp-flip__link">
          <picture>
            <source media="(max-width: 749px)" srcset="{{ 'lectopolis-hero-book-mobile.webp' | asset_url }}">
            <img class="lp-flip__img" src="{{ 'lectopolis-hero-book-desktop.webp' | asset_url }}" width="1440" height="720" loading="eager" fetchpriority="high" alt="Explorar todos los libros de Lectópolis">
          </picture>
        </a>
      </div>
    {%- endif -%}
  </div>

  {%- if slide_count > 1 or section.settings.show_bar -%}
  <div class="lp-flip__footer">
  {%- if slide_count > 1 -%}
    <div class="lp-flip__controls">
      <button type="button" class="lp-flip__arrow lp-flip__arrow--prev" data-lp-flip-prev aria-label="Banner anterior">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="lp-flip__dots" role="group" aria-label="Elegir banner">
        {%- for i in (1..slide_count) -%}
          <button type="button" class="lp-flip__dot{% if forloop.first %} is-active{% endif %}" data-lp-flip-dot="{{ forloop.index0 }}" aria-label="Ir al banner {{ i }}"{% if forloop.first %} aria-current="true"{% endif %}><span></span></button>
        {%- endfor -%}
      </div>
      <button type="button" class="lp-flip__arrow lp-flip__arrow--next" data-lp-flip-next aria-label="Banner siguiente">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      {%- if section.settings.autoplay -%}
        <button type="button" class="lp-flip__pause" data-lp-flip-pause aria-label="Pausar el pase automático" aria-pressed="false">
          <svg class="lp-flip__icon-pause" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path d="M8 5v14M16 5v14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
          <svg class="lp-flip__icon-play" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path d="M8 5l11 7-11 7z" fill="currentColor"/></svg>
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.settings.show_bar -%}
    <div class="lp-flip__bar">
      {%- if section.settings.caption != blank -%}<p class="lp-flip__caption">{{ section.settings.caption | escape }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="lp-flip__cta" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">→</span></a>
      {%- endif -%}
    </div>
  {%- endif -%}
  </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Lectópolis · Hero libro",
  "tag": "div",
  "class": "lp-flip-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Los banners pasan como la hoja de un libro abierto. Agrega al menos dos banners con la misma proporción (recomendado 2172 × 724 px). Sin banners se muestra el banner de Lectópolis."
    },
    { "type": "text", "id": "label", "label": "Nombre para accesibilidad", "default": "Banners de Lectópolis" },
    { "type": "checkbox", "id": "autoplay", "label": "Pasar banners automáticamente", "default": false },
    { "type": "range", "id": "interval", "label": "Tiempo por banner", "min": 4, "max": 12, "step": 1, "unit": "s", "default": 6 },
    { "type": "range", "id": "duration", "label": "Duración del paso de página", "min": 8, "max": 22, "step": 1, "unit": "ds", "default": 14, "info": "En décimas de segundo (14 = 1,4 s)." },
    { "type": "header", "content": "Franja inferior" },
    { "type": "checkbox", "id": "show_bar", "label": "Mostrar franja con botón", "default": true },
    { "type": "text", "id": "caption", "label": "Texto", "default": "Más de 15 años compartiendo historias." },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Ver todos los libros" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Banner",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen (escritorio)" },
        { "type": "image_picker", "id": "mobile_image", "label": "Imagen para móvil (opcional)", "info": "Usa la misma proporción en todos los banners de móvil." },
        { "type": "url", "id": "link", "label": "Enlace" },
        { "type": "text", "id": "alt", "label": "Texto alternativo", "info": "Describe lo que dice el banner para lectores de pantalla y buscadores." }
      ]
    }
  ],
  "presets": [
    { "name": "Lectópolis · Hero libro", "blocks": [{ "type": "slide" }, { "type": "slide" }] }
  ],
  "enabled_on": { "templates": ["index"] }
}
{% endschema %}
