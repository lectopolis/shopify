<section class="page-width icaro-discover" aria-labelledby="Discover-{{ section.id }}">
  <div class="icaro-section-head">
    <div><p class="icaro-eyebrow">SIGUE TU CURIOSIDAD</p><h2 id="Discover-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
    <p>{{ section.settings.subheading | escape }}</p>
  </div>
  <icaro-quiz class="icaro-quiz">
    <div class="icaro-quiz__progress" data-progress aria-hidden="true"><span></span></div>

    <div class="icaro-quiz__step is-current" data-step>
      <p class="icaro-quiz__count">1 de 3</p>
      <h3>¿Qué te gustaría leer?</h3>
      <div class="icaro-discover__grid icaro-quiz__options">
        {%- for block in section.blocks -%}
          {%- assign interest = block.settings.collection -%}
          {%- if interest != blank -%}
            {%- assign interest_label = block.settings.label | default: interest.title -%}
            <a class="icaro-quiz__option" href="{{ interest.url }}" data-key="topic" data-answer="{{ interest.handle }}" data-url="{{ interest.url }}" data-label="{{ interest_label | escape }}" {{ block.shopify_attributes }}>
              <span class="icaro-eyebrow">0{{ forloop.index }}</span><h4>{{ interest_label | escape }}</h4><span aria-hidden="true">↗</span>
            </a>
          {%- elsif request.design_mode -%}
            <div {{ block.shopify_attributes }}>Selecciona una colección.</div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="icaro-quiz__step" data-step hidden>
      <p class="icaro-quiz__count">2 de 3</p>
      <h3>¿Cuánto quieres invertir en tu próximo libro?</h3>
      <div class="icaro-discover__grid icaro-quiz__options">
        <button type="button" class="icaro-quiz__option" data-key="budget" data-answer="0-60000"><span class="icaro-eyebrow">A</span><h4>Hasta $60.000</h4><span aria-hidden="true">→</span></button>
        <button type="button" class="icaro-quiz__option" data-key="budget" data-answer="60000-100000"><span class="icaro-eyebrow">B</span><h4>$60.000 – $100.000</h4><span aria-hidden="true">→</span></button>
        <button type="button" class="icaro-quiz__option" data-key="budget" data-answer="all"><span class="icaro-eyebrow">C</span><h4>Sin límite</h4><span aria-hidden="true">→</span></button>
      </div>
      <button type="button" class="icaro-quiz__back" data-back>← Volver</button>
    </div>

    <div class="icaro-quiz__step" data-step hidden>
      <p class="icaro-quiz__count">3 de 3</p>
      <h3>¿Qué te provoca hoy?</h3>
      <div class="icaro-discover__grid icaro-quiz__options">
        <button type="button" class="icaro-quiz__option" data-key="mood" data-answer="new"><span class="icaro-eyebrow">A</span><h4>Lo más reciente</h4><span aria-hidden="true">→</span></button>
        <button type="button" class="icaro-quiz__option" data-key="mood" data-answer="classic"><span class="icaro-eyebrow">B</span><h4>Clásicos de fondo</h4><span aria-hidden="true">→</span></button>
        <button type="button" class="icaro-quiz__option" data-key="mood" data-answer="surprise"><span class="icaro-eyebrow">C</span><h4>Sorpréndeme</h4><span aria-hidden="true">→</span></button>
      </div>
      <button type="button" class="icaro-quiz__back" data-back>← Volver</button>
    </div>

    <div class="icaro-quiz__step" data-step hidden>
      <div class="icaro-quiz__result-head">
        <h3 data-results-title>Tu selección</h3>
        <div><a href="{{ routes.all_products_collection_url }}" data-results-more>Ver la colección completa →</a><button type="button" class="icaro-quiz__back" data-restart>↺ Empezar de nuevo</button></div>
      </div>
      <div class="icaro-quiz__results" data-results aria-live="polite"></div>
    </div>
  </icaro-quiz>
</section>
{% schema %}
{"name":"Ícaro · Descubrimiento","max_blocks":6,"settings":[
{"type":"text","id":"heading","label":"Título","default":"Encuentra tu próxima lectura"},
{"type":"text","id":"subheading","label":"Texto","default":"Tres preguntas y te recomendamos libros disponibles hoy."}],
"blocks":[{"type":"interest","name":"Interés","settings":[{"type":"collection","id":"collection","label":"Colección"},{"type":"text","id":"label","label":"Título opcional"}]}],
"presets":[{"name":"Ícaro · Descubrimiento"}]}
{% endschema %}
