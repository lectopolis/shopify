{{ 'lectopolis-editorial-divider.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign editorial_collection = section.settings.collection
  assign editorial_heading = section.settings.heading | default: editorial_collection.title | default: 'Descubre nuestros libros'
  assign editorial_alt = section.settings.image.alt | default: editorial_heading
  assign has_editorial_image = false
  if section.settings.image and section.settings.image != blank
    assign has_editorial_image = true
  endif
-%}
<section class="lp-editorial-divider lp-editorial-divider--{{ section.settings.palette }}" aria-labelledby="lp-editorial-heading-{{ section.id }}">
  {% if has_editorial_image %}
    <div class="lp-editorial-divider__image">
      <picture>
        {% if section.settings.mobile_image and section.settings.mobile_image != blank %}
          <source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 375 }} 375w, {{ section.settings.mobile_image | image_url: width: 750 }} 750w, {{ section.settings.mobile_image | image_url: width: 1100 }} 1100w" sizes="100vw" width="{{ section.settings.mobile_image.width }}" height="{{ section.settings.mobile_image.height }}">
        {% endif %}
        {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '375,750,1100,1500,2000,2400', sizes: '100vw', loading: 'lazy', alt: editorial_alt }}
      </picture>
    </div>
  {% endif %}
  <div class="lp-editorial-divider__content page-width{% if has_editorial_image %} lp-editorial-divider__content--with-image{% endif %}">
    <div class="lp-editorial-divider__copy">
      <p class="lp-editorial-divider__eyebrow">DESCUBRE ESTA EDITORIAL EN LECTÓPOLIS</p>
      <h2 id="lp-editorial-heading-{{ section.id }}">{{ editorial_heading | escape }}</h2>
      {% if section.settings.description != blank %}<p class="lp-editorial-divider__description">{{ section.settings.description | escape }}</p>{% endif %}
      {% if section.settings.show_button and editorial_collection != blank %}<a class="lp-editorial-divider__button" href="{{ editorial_collection.url }}">Ver todos sus libros {% render 'lectopolis-icon' %}</a>{% endif %}
    </div>
    {% unless has_editorial_image %}<div class="lp-editorial-divider__books" aria-hidden="true"><span></span><span></span><span></span></div>{% endunless %}
  </div>
</section>
{% schema %}
{
  "name":"Separador de colección",
  "enabled_on":{"templates":["index"]},
  "settings":[
    {"type":"paragraph","content":"Banner que separa los grupos de libros en la portada. El diseño con el nombre de la editorial es visible sin subir imágenes. Puedes reemplazarlo con un banner propio."},
    {"type":"collection","id":"collection","label":"Colección / editorial"},
    {"type":"text","id":"heading","label":"Nombre visible de la editorial","info":"Si lo dejas vacío, se utiliza el nombre de la colección."},
    {"type":"text","id":"description","label":"Texto breve","default":"Encuentra tu próxima lectura entre los libros de esta editorial."},
    {"type":"select","id":"palette","label":"Colores","default":"purple","options":[{"value":"purple","label":"Violeta y amarillo"},{"value":"blue","label":"Azul y blanco"},{"value":"mint","label":"Menta y verde"}]},
    {"type":"image_picker","id":"image","label":"Banner propio para escritorio (opcional)","info":"Recomendado: 2000 × 650 px. Se muestra completo, sin recortar."},
    {"type":"image_picker","id":"mobile_image","label":"Banner propio para celular (opcional)"},
    {"type":"checkbox","id":"show_button","label":"Mostrar botón a la colección","default":true}
  ],
  "presets":[{"name":"Separador de colección"}]
}
{% endschema %}
