{{ 'lectopolis-editorial-divider.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign editorial_collection = section.settings.collection
  assign editorial_heading = section.settings.heading | default: editorial_collection.title | default: 'Descubre nuestros libros'
  assign editorial_alt = section.settings.image.alt | default: editorial_heading
  assign has_editorial_image = false
  if section.settings.image and section.settings.image != blank
    assign has_editorial_image = true
  endif
-%}
{% if has_editorial_image %}
  <script src="{{ 'lectopolis-editorial-divider.js' | asset_url }}" defer></script>
  <section class="lp-editorial-divider" aria-label="{{ editorial_heading | escape }}" data-lp-editorial-motion="{{ section.settings.enable_3d }}">
    <div class="lp-editorial-divider__stage">
      {% if editorial_collection != blank %}<a class="lp-editorial-divider__surface" href="{{ editorial_collection.url }}" aria-label="{{ editorial_heading | escape }}">{% else %}<div class="lp-editorial-divider__surface">{% endif %}
        <picture>
          {% if section.settings.mobile_image and section.settings.mobile_image != blank %}
            <source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 375 }} 375w, {{ section.settings.mobile_image | image_url: width: 750 }} 750w, {{ section.settings.mobile_image | image_url: width: 1100 }} 1100w" sizes="100vw" width="{{ section.settings.mobile_image.width }}" height="{{ section.settings.mobile_image.height }}">
          {% endif %}
          {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '375,750,1100,1500,2000,2400', sizes: '100vw', loading: 'lazy', alt: editorial_alt }}
        </picture>
      {% if editorial_collection != blank %}</a>{% else %}</div>{% endif %}
    </div>
  </section>
{% elsif request.design_mode %}
  <div class="lp-editorial-divider__placeholder page-width"><p>Selecciona una imagen de banner para {{ editorial_heading | escape }}. Solo aparece esta ayuda en el editor.</p></div>
{% endif %}
{% schema %}
{
  "name": "Separador de colección",
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Solo se muestra la imagen del banner, con un efecto 3D suave. No se muestran franjas, t?tulos ni botones adicionales. Si no eliges una imagen, el separador queda oculto para los visitantes."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección / editorial"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Nombre para accesibilidad",
      "info": "Se usa en el texto alternativo y en los lectores de pantalla; no aparece sobre la imagen."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner propio para escritorio (opcional)",
      "info": "Recomendado: 2000 × 650 px. Se muestra completo, sin recortar."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Banner propio para celular (opcional)"
    },
    {
      "type": "checkbox",
      "id": "enable_3d",
      "label": "Activar movimiento 3D suave",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Separador de colección"
    }
  ]
}
{% endschema %}
