<style>
  .icaro-authors{padding-top:36px;padding-bottom:40px}
  .icaro-authors__grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:12px;margin:20px 0 0;padding:0;list-style:none}
  .icaro-authors__item a{display:block;height:100%;padding:16px 18px;border:1px solid rgba(var(--color-foreground),.14);border-radius:6px;text-decoration:none;color:rgb(var(--color-foreground))}
  .icaro-authors__item a:hover,.icaro-authors__item a:focus-visible{border-color:rgba(var(--color-foreground),.5)}
  .icaro-authors__name{display:block;font-weight:600;font-size:1.6rem;line-height:1.3}
  .icaro-authors__note{display:block;margin-top:4px;font-size:1.3rem;line-height:1.4;opacity:.75}
  .icaro-authors__count{display:block;margin-top:8px;font-size:1.2rem;opacity:.65}
</style>
<section class="page-width icaro-authors" aria-labelledby="Authors-{{ section.id }}">
  <div class="icaro-section-head">
    <div><p class="icaro-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="Authors-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
    {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading | escape }}</p>{%- endif -%}
  </div>
  <ul class="icaro-authors__grid" role="list">
    {%- for block in section.blocks -%}
      {%- assign author_collection = block.settings.collection -%}
      {%- if author_collection != blank -%}
        <li class="icaro-authors__item" {{ block.shopify_attributes }}>
          <a href="{{ author_collection.url }}">
            <span class="icaro-authors__name">{{ block.settings.label | default: author_collection.title | escape }}</span>
            {%- if block.settings.note != blank -%}<span class="icaro-authors__note">{{ block.settings.note | escape }}</span>{%- endif -%}
            <span class="icaro-authors__count">{{ author_collection.all_products_count }} títulos</span>
          </a>
        </li>
      {%- elsif request.design_mode -%}
        <li class="icaro-authors__item" {{ block.shopify_attributes }}>Selecciona una colección.</li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</section>
{% schema %}
{
  "name": "Ícaro · Autores",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño", "default": "AUTORES" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Autores que buscan nuestros lectores" },
    { "type": "text", "id": "subheading", "label": "Subtítulo" }
  ],
  "blocks": [
    {
      "type": "author",
      "name": "Autor",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección del autor" },
        { "type": "text", "id": "label", "label": "Nombre a mostrar (opcional)" },
        { "type": "text", "id": "note", "label": "Frase corta (opcional)" }
      ]
    }
  ],
  "presets": [{ "name": "Ícaro · Autores" }]
}
{% endschema %}
