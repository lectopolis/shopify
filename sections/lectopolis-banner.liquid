<section class="lp-campaign" aria-label="Cada libro tiene un lector. El próximo eres tú.">
  <a class="lp-campaign-image" href="{{ routes.all_products_collection_url }}" aria-label="Descubre los libros de Librería Lectópolis">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '750,1100,1600,2172,2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: 'Lectópolis — Amamos leer. Cada libro tiene un lector. El próximo eres tú. Libros nuevos y leídos. Envíos nacionales.' }}
    {% else %}
      <img src="{{ 'lectopolis-banner-logo-1100.webp' | asset_url }}" srcset="{{ 'lectopolis-banner-logo-750.webp' | asset_url }} 750w, {{ 'lectopolis-banner-logo-1100.webp' | asset_url }} 1100w, {{ 'lectopolis-banner-logo-1600.webp' | asset_url }} 1600w, {{ 'lectopolis-banner-logo-2172.webp' | asset_url }} 2172w" sizes="100vw" width="2172" height="724" decoding="async" loading="eager" fetchpriority="high" alt="Lectópolis — Amamos leer. Cada libro tiene un lector. El próximo eres tú. Libros nuevos y leídos. Envíos nacionales.">
    {% endif %}
  </a>
  <div class="lp-campaign-bottom">
    <div class="lp-campaign-mobile-copy"><h2>Cada libro tiene un lector. <em>El próximo eres tú.</em></h2><p>Libros nuevos y leídos · Envíos nacionales</p></div>
    <span class="lp-campaign-caption">Más de 15 años compartiendo historias.</span>
    <a class="lp-campaign-cta" href="{{ routes.all_products_collection_url }}">Explora nuestros libros {% render 'lectopolis-icon' %}</a>
  </div>
</section>
{% schema %}
{"name":"Lectópolis · Banner","settings":[{"type":"image_picker","id":"image","label":"Imagen del banner","info":"Si no seleccionas una imagen, se muestra el banner de Lectópolis."}],"presets":[{"name":"Lectópolis · Banner"}]}
{% endschema %}
