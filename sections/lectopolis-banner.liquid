<section class="lp-campaign" aria-label="Tu próxima historia favorita te está esperando">
  <a class="lp-campaign-image" href="{{ routes.all_products_collection_url }}" aria-label="Descubre los libros de Librería Lectópolis">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '750,1100,1600,2172,2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: 'Lectópolis. Tu próxima historia favorita te está esperando. Libros nuevos y leídos. Envíos nacionales.' }}
    {% else %}
      <img src="{{ 'lectopolis-banner-historias-v1.png' | asset_url }}" width="2172" height="724" loading="eager" fetchpriority="high" alt="Lectópolis. Tu próxima historia favorita te está esperando. Libros nuevos y leídos. Envíos nacionales.">
    {% endif %}
  </a>
  <div class="lp-campaign-bottom">
    <div class="lp-campaign-mobile-copy"><h2>Tu próxima <em>historia favorita</em> te está esperando.</h2><p>Libros nuevos y leídos · Envíos nacionales</p></div>
    <span class="lp-campaign-caption">Más de 15 años conectando libros y lectores.</span>
    <a class="lp-campaign-cta" href="{{ routes.all_products_collection_url }}">Explora nuestros libros {% render 'lectopolis-icon' %}</a>
  </div>
</section>
{% schema %}
{"name":"Lectópolis · Banner","settings":[{"type":"image_picker","id":"image","label":"Imagen del banner","info":"Si no seleccionas una imagen, se muestra el banner de Lectópolis."}],"presets":[{"name":"Lectópolis · Banner"}]}
{% endschema %}
