{% comment %}
  Sección: Pie de artículo con tags y vuelta al blog
{% endcomment %}

<style>
  .ic-footer-{{ section.id }} {
    --ic-muted: {{ section.settings.muted_color }};
    --ic-gold: {{ section.settings.accent_color }};
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 40px 24px 80px;
    border-top: 1px solid {{ section.settings.accent_color }}4D;
    text-align: center;
  }
  .ic-footer-{{ section.id }}__tags {
    display: flex; flex-wrap: wrap;
    gap: 8px; justify-content: center;
    margin-bottom: 24px;
  }
  .ic-footer-{{ section.id }}__tag {
    font-size: 12px;
    padding: 4px 12px;
    background: {{ section.settings.accent_color }}1A;
    color: var(--ic-gold);
    border-radius: 100px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .ic-footer-{{ section.id }}__tag:hover {
    background: {{ section.settings.accent_color }}40;
  }
  .ic-footer-{{ section.id }}__back {
    display: inline-block;
    font-size: 14px;
    color: var(--ic-muted);
    text-decoration: none;
    letter-spacing: 1px;
    margin-top: 12px;
  }
  .ic-footer-{{ section.id }}__back:hover { color: var(--ic-gold); }
  .ic-footer-{{ section.id }}__share {
    margin-top: 32px;
    font-size: 13px;
    color: var(--ic-muted);
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .ic-footer-{{ section.id }}__share a {
    color: var(--ic-gold);
    margin: 0 8px;
    text-decoration: none;
  }
</style>

{{ 'icaro-premium-article.css' | asset_url | stylesheet_tag }}

<footer class="ic-footer-{{ section.id }}{% unless section.settings.editorial_design == false %} icaro-premium-footer{% endunless %}">
  {%- if section.settings.show_tags and article.tags.size > 0 -%}
    <div class="ic-footer-{{ section.id }}__tags">
      {%- for tag in article.tags -%}
        <a href="{{ blog.url }}/tagged/{{ tag | handleize }}" class="ic-footer-{{ section.id }}__tag">{{ tag }}</a>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.show_share -%}
    <div class="ic-footer-{{ section.id }}__share">
      Compartir:
      <a href="https://www.facebook.com/sharer.php?u={{ shop.url }}{{ article.url }}" target="_blank" rel="noopener">Facebook</a>
      <a href="https://twitter.com/intent/tweet?url={{ shop.url }}{{ article.url }}&text={{ article.title | url_encode }}" target="_blank" rel="noopener">X</a>
      <a href="https://wa.me/?text={{ article.title | url_encode }}%20{{ shop.url }}{{ article.url | url_encode }}" target="_blank" rel="noopener">WhatsApp</a>
    </div>
  {%- endif -%}

  {%- if section.settings.show_back -%}
    <div>
      <a href="{{ blog.url }}" class="ic-footer-{{ section.id }}__back">← {{ section.settings.back_text }}</a>
    </div>
  {%- endif -%}
</footer>

{% schema %}
{
  "name": "Pie artículo Ícaro",
  "tag": "section",
  "class": "section-article-footer",
  "settings": [
    { "type": "checkbox", "id": "editorial_design", "label": "Usar diseño editorial Ícaro", "default": true },
    { "type": "paragraph", "content": "El diseño editorial usa fondo blanco, acento terracota y proporciones compactas. Los controles de estilo siguientes se aplican al desactivar esta opción." },
    { "type": "checkbox", "id": "show_tags",  "label": "Mostrar etiquetas", "default": true },
    { "type": "checkbox", "id": "show_share", "label": "Mostrar botones de compartir", "default": true },
    { "type": "checkbox", "id": "show_back",  "label": "Mostrar volver al blog", "default": true },
    { "type": "text",     "id": "back_text",  "label": "Texto del enlace de vuelta", "default": "Volver al blog" },
    {
      "type": "range",
      "id": "max_width",
      "label": "Ancho máximo",
      "min": 600, "max": 900, "step": 20,
      "default": 720, "unit": "px"
    },
    { "type": "color", "id": "muted_color",  "label": "Color secundario", "default": "#6b6058" },
    { "type": "color", "id": "accent_color", "label": "Color de acento",  "default": "#c9a063" }
  ],
  "presets": [
    { "name": "Pie artículo Ícaro" }
  ]
}
{% endschema %}
