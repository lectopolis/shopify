{% comment %}
  Sección: Contenido editorial del artículo
  Incluye cabecera (fecha, título, autor), cuerpo con letra capitular y CTAs
{% endcomment %}

<style>
  .ic-article-{{ section.id }} {
    --ic-text: {{ section.settings.text_color }};
    --ic-muted: {{ section.settings.muted_color }};
    --ic-gold: {{ section.settings.accent_color }};
    --ic-bg-dark: {{ section.settings.cta_bg_color }};
    --ic-serif: {{ section.settings.font_serif }};
    --ic-max-width: {{ section.settings.max_width }}px;
  }

  .ic-article-{{ section.id }}__header {
    max-width: var(--ic-max-width);
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 24px 40px;
    text-align: {{ section.settings.text_align }};
  }
  .ic-article-{{ section.id }}__meta {
    font-family: var(--ic-serif);
    font-size: 13px;
    letter-spacing: 4px;
    color: var(--ic-gold);
    text-transform: uppercase;
    margin-bottom: 24px;
    font-weight: 600;
  }
  {%- if section.settings.text_align == 'center' -%}
  .ic-article-{{ section.id }}__meta::after {
    content: ""; display: block;
    width: 40px; height: 2px;
    background: var(--ic-gold);
    margin: 16px auto 0;
  }
  {%- endif -%}
  .ic-article-{{ section.id }}__title {
    font-family: var(--ic-serif);
    font-size: clamp(28px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.2;
    color: var(--ic-text);
    margin: 0 0 24px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .ic-article-{{ section.id }}__excerpt {
    font-family: var(--ic-serif);
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.6;
    color: var(--ic-muted);
    font-style: italic;
    max-width: 600px;
    margin: 0 auto;
  }
  .ic-article-{{ section.id }}__byline {
    font-size: 14px;
    color: var(--ic-muted);
    margin-top: 32px;
    letter-spacing: 1px;
  }
  .ic-article-{{ section.id }}__byline strong {
    color: var(--ic-gold);
    font-weight: 600;
  }

  .ic-article-{{ section.id }}__body {
    max-width: var(--ic-max-width);
    margin: 0 auto;
    padding: 40px 24px 80px;
    font-family: var(--ic-serif);
    font-size: clamp(17px, 2vw, {{ section.settings.body_size }}px);
    line-height: 1.75;
    color: var(--ic-text);
  }
  .ic-article-{{ section.id }}__body p { margin: 0 0 1.5em; }

  {%- if section.settings.dropcap -%}
  .ic-article-{{ section.id }}__body p:first-of-type::first-letter {
    font-size: 4.5em;
    line-height: 0.85;
    float: left;
    margin: 0.05em 0.15em 0 0;
    color: var(--ic-gold);
    font-weight: 700;
  }
  {%- endif -%}

  .ic-article-{{ section.id }}__body h2 {
    font-family: var(--ic-serif);
    font-size: clamp(22px, 3vw, 30px);
    line-height: 1.3;
    margin: 2.5em 0 0.8em;
    color: var(--ic-text);
    font-weight: 700;
  }
  .ic-article-{{ section.id }}__body h3 {
    font-family: var(--ic-serif);
    font-size: clamp(19px, 2.4vw, 24px);
    margin: 2em 0 0.6em;
    color: var(--ic-text);
    font-weight: 600;
  }
  .ic-article-{{ section.id }}__body hr {
    border: none; text-align: center;
    margin: 3em 0; height: 30px;
    position: relative;
  }
  .ic-article-{{ section.id }}__body hr::before {
    content: "{{ section.settings.divider_symbol }}";
    color: var(--ic-gold); font-size: 24px;
    position: absolute; top: 0; left: 50%;
    transform: translateX(-50%);
  }
  .ic-article-{{ section.id }}__body blockquote {
    margin: 2em 0;
    padding: 24px 32px;
    border-left: 4px solid var(--ic-gold);
    background: rgba(201, 160, 99, 0.06);
    font-style: italic;
    font-size: 1.1em;
    color: var(--ic-gold);
  }
  .ic-article-{{ section.id }}__body blockquote cite {
    display: block; margin-top: 12px;
    font-size: 0.85em; color: var(--ic-muted);
    font-style: normal;
  }
  .ic-article-{{ section.id }}__body ul,
  .ic-article-{{ section.id }}__body ol {
    padding-left: 1.5em; margin: 1.5em 0;
  }
  .ic-article-{{ section.id }}__body li { margin-bottom: 0.6em; }
  .ic-article-{{ section.id }}__body strong { color: var(--ic-text); font-weight: 700; }
  .ic-article-{{ section.id }}__body em { color: var(--ic-gold); }
  .ic-article-{{ section.id }}__body a {
    color: var(--ic-gold);
    text-decoration: none;
    border-bottom: 1px solid var(--ic-gold);
    transition: all 0.2s;
  }
  .ic-article-{{ section.id }}__body a:hover {
    opacity: 0.7;
  }
  /* CTA destacado (strong > a) */
  .ic-article-{{ section.id }}__body p > strong > a {
    display: inline-block;
    padding: 14px 28px;
    background: var(--ic-bg-dark);
    color: var(--ic-gold) !important;
    border: 2px solid var(--ic-gold);
    border-radius: 4px;
    font-weight: 600;
    letter-spacing: 1px;
    margin-top: 1em;
    transition: all 0.3s;
  }
  .ic-article-{{ section.id }}__body p > strong > a:hover {
    background: var(--ic-gold);
    color: var(--ic-bg-dark) !important;
  }

  @media (max-width: 640px) {
    .ic-article-{{ section.id }}__header { padding: 40px 20px 24px; }
    .ic-article-{{ section.id }}__body { padding: 24px 20px 60px; }
    {%- if section.settings.dropcap -%}
    .ic-article-{{ section.id }}__body p:first-of-type::first-letter { font-size: 3.5em; }
    {%- endif -%}
  }
</style>

{{ 'icaro-premium-article.css' | asset_url | stylesheet_tag }}
{{ 'icaro-article-content.css' | asset_url | stylesheet_tag }}

<article class="ic-article-{{ section.id }}{% unless section.settings.editorial_design == false %} icaro-premium-content icaro-article-reader{% endunless %}" style="--reading-width: {{ section.settings.max_width }}px; --reading-size: {{ section.settings.body_size }}px; --reading-space: {{ section.settings.padding_top }}px;">
  {%- if section.settings.show_header and section.settings.editorial_design == false -%}
  <header class="ic-article-{{ section.id }}__header">
    {%- if section.settings.show_meta -%}
    <div class="ic-article-{{ section.id }}__meta">
      {{ article.published_at | date: "%d de %B, %Y" }}
      {%- if blog -%} · {{ blog.title }}{%- endif -%}
    </div>
    {%- endif -%}

    <h1 class="ic-article-{{ section.id }}__title">{{ article.title }}</h1>

    {%- if article.excerpt != blank and section.settings.show_excerpt -%}
      <div class="ic-article-{{ section.id }}__excerpt">{{ article.excerpt }}</div>
    {%- endif -%}

    {%- if section.settings.show_author -%}
    <div class="ic-article-{{ section.id }}__byline">
      Por <strong>{{ article.author }}</strong>
    </div>
    {%- endif -%}
  </header>
  {%- endif -%}

  <div class="ic-article-{{ section.id }}__body icaro-article-text">
    {{ article.content }}
  </div>
</article>

{% schema %}
{
  "name": "Contenido artículo Ícaro",
  "tag": "section",
  "class": "section-article-content",
  "settings": [
    { "type": "checkbox", "id": "editorial_design", "label": "Usar diseño editorial Ícaro", "default": true },
    { "type": "paragraph", "content": "El diseño editorial permite ajustar el ancho, tamaño del cuerpo y espacio superior. La cabecera se edita en Hero artículo Ícaro. Los demás controles de estilo corresponden al diseño clásico." },
    {
      "type": "header",
      "content": "Mostrar"
    },
    { "type": "checkbox", "id": "show_header",  "label": "Mostrar cabecera",          "default": true },
    { "type": "checkbox", "id": "show_meta",    "label": "Mostrar fecha y blog",       "default": true },
    { "type": "checkbox", "id": "show_excerpt", "label": "Mostrar resumen",            "default": true },
    { "type": "checkbox", "id": "show_author",  "label": "Mostrar autor",              "default": true },
    { "type": "checkbox", "id": "dropcap",      "label": "Letra capitular dorada",     "default": true },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alineación de la cabecera",
      "options": [
        { "value": "center", "label": "Centrado" },
        { "value": "left",   "label": "Izquierda" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Ancho máximo del texto",
      "min": 600,
      "max": 900,
      "step": 20,
      "default": 720,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior",
      "min": 20,
      "max": 120,
      "step": 10,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Tamaño del título (máx)",
      "min": 32,
      "max": 64,
      "step": 2,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Tamaño del cuerpo (máx)",
      "min": 15,
      "max": 22,
      "step": 1,
      "default": 19,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colores"
    },
    { "type": "color", "id": "text_color",     "label": "Color de texto",       "default": "#2a2624" },
    { "type": "color", "id": "muted_color",    "label": "Color secundario",     "default": "#6b6058" },
    { "type": "color", "id": "accent_color",   "label": "Color de acento",      "default": "#c9a063" },
    { "type": "color", "id": "cta_bg_color",   "label": "Fondo del botón CTA",  "default": "#1a1818" },
    {
      "type": "header",
      "content": "Tipografía"
    },
    {
      "type": "text",
      "id": "font_serif",
      "label": "Familia tipográfica",
      "default": "Georgia, 'Times New Roman', serif"
    },
    {
      "type": "text",
      "id": "divider_symbol",
      "label": "Símbolo del separador (hr)",
      "default": "❦"
    }
  ],
  "presets": [
    { "name": "Contenido artículo Ícaro" }
  ]
}
{% endschema %}
