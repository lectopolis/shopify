{% comment %}
  Sección: Hero adaptativo para artículos de blog
  Detecta si la imagen es vertical u horizontal y se adapta.
{% endcomment %}

{%- assign img = article.image -%}
{%- assign is_vertical = false -%}
{%- if img and img.width < img.height -%}
  {%- assign is_vertical = true -%}
{%- endif -%}

<style>
  .ic-hero-{{ section.id }} {
    --ic-bg-dark: {{ section.settings.bg_color }};
    --ic-gold: {{ section.settings.accent_color }};
    position: relative;
    width: 100%;
    background: var(--ic-bg-dark);
    overflow: hidden;
  }
  .ic-hero-{{ section.id }}--vertical {
    min-height: {{ section.settings.vertical_height }}vh;
    max-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ic-hero-{{ section.id }}--vertical .ic-hero__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: blur({{ section.settings.blur_amount }}px) brightness(0.5) saturate(1.2);
    transform: scale(1.2);
  }
  .ic-hero-{{ section.id }}--vertical .ic-hero__img {
    position: relative;
    z-index: 1;
    max-height: 80vh;
    max-width: min(90vw, 480px);
    border-radius: 8px;
    box-shadow: 0 30px 80px rgba(0,0,0,0.6), 0 10px 30px rgba(0,0,0,0.4);
    object-fit: contain;
  }
  .ic-hero-{{ section.id }}--horizontal {
    aspect-ratio: {{ section.settings.horizontal_ratio }};
    max-height: 70vh;
  }
  .ic-hero-{{ section.id }}--horizontal .ic-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  @media (max-width: 640px) {
    .ic-hero-{{ section.id }}--vertical { min-height: 60vh; }
    .ic-hero-{{ section.id }}--vertical .ic-hero__img {
      max-height: 65vh; max-width: 75vw;
    }
  }
</style>

{{ 'icaro-premium-article.css' | asset_url | stylesheet_tag }}

{%- unless section.settings.editorial_design == false -%}
<div class="icaro-article-opening{% if img == blank %} icaro-article-opening--text{% endif %}">
  {% render 'icaro-article-heading' %}
{%- endunless -%}

{%- if img -%}
  {%- if is_vertical -%}
    <div class="ic-hero-{{ section.id }}{% unless section.settings.editorial_design == false %} icaro-premium-hero{% endunless %} ic-hero-{{ section.id }}--vertical">
      {%- if section.settings.show_blur_bg -%}
        <div class="ic-hero__bg" style="background-image: url({{ img | image_url: width: 600 }});"></div>
      {%- endif -%}
      <img class="ic-hero__img"
           src="{{ img | image_url: width: 1200 }}"
           alt="{{ img.alt | escape | default: article.title | escape }}"
           width="{{ img.width }}" height="{{ img.height }}" loading="eager">
    </div>
  {%- else -%}
    <div class="ic-hero-{{ section.id }}{% unless section.settings.editorial_design == false %} icaro-premium-hero{% endunless %} ic-hero-{{ section.id }}--horizontal">
      <img class="ic-hero__img"
           src="{{ img | image_url: width: 1800 }}"
           alt="{{ img.alt | escape | default: article.title | escape }}"
           width="{{ img.width }}" height="{{ img.height }}" loading="eager">
    </div>
  {%- endif -%}
{%- endif -%}

{%- unless section.settings.editorial_design == false -%}</div>{%- endunless -%}

{% schema %}
{
  "name": "Hero artículo Ícaro",
  "tag": "section",
  "class": "section-article-hero",
  "settings": [
    { "type": "checkbox", "id": "editorial_design", "label": "Usar diseño editorial Ícaro", "default": true },
    { "type": "paragraph", "content": "El diseño editorial usa fondo blanco, acento terracota y proporciones compactas. Los controles de estilo siguientes se aplican al desactivar esta opción." },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo (vertical)",
      "default": "#1a1818"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color de acento",
      "default": "#c9a063"
    },
    {
      "type": "header",
      "content": "Imagen vertical"
    },
    {
      "type": "checkbox",
      "id": "show_blur_bg",
      "label": "Mostrar fondo desenfocado",
      "default": true
    },
    {
      "type": "range",
      "id": "blur_amount",
      "label": "Intensidad del desenfoque",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "vertical_height",
      "label": "Altura del hero (vertical)",
      "min": 50,
      "max": 100,
      "step": 5,
      "default": 70,
      "unit": "vh"
    },
    {
      "type": "header",
      "content": "Imagen horizontal"
    },
    {
      "type": "select",
      "id": "horizontal_ratio",
      "label": "Proporción",
      "options": [
        { "value": "16 / 9", "label": "16:9 (cine)" },
        { "value": "21 / 9", "label": "21:9 (ultrawide)" },
        { "value": "3 / 2", "label": "3:2 (foto clásica)" },
        { "value": "4 / 3", "label": "4:3" }
      ],
      "default": "16 / 9"
    }
  ],
  "presets": [
    { "name": "Hero artículo Ícaro" }
  ]
}
{% endschema %}
