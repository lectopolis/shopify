{%- assign publisher_list = 'editorial-abada:icaro-publisher-01.png,editorial-alba:icaro-publisher-02.png,editorial-archivos-vola:icaro-publisher-03.png,editorial-arena-libros:icaro-publisher-04.png,libros-editorial-cactus:icaro-publisher-05.png,editorial-capital-intelectual:icaro-publisher-06.png,editorial-casimiro:icaro-publisher-07.png,editorial-catedra:icaro-publisher-08.png,editorial-el-ateneo:icaro-publisher-10.png,editorial-el-cuenco-de-plata:icaro-publisher-11.png,editorial-gorla:icaro-publisher-12.png,editorial-grito-sagrado:icaro-publisher-13.png,editorial-guillermo-escolar:icaro-publisher-14.png,editorial-hiperion:icaro-publisher-15.png,editorial-herramienta:icaro-publisher-16.png,editorial-las-cuarenta:icaro-publisher-17.png,editorial-la-cebra:icaro-publisher-18.png,editorial-morata:icaro-publisher-19.png,editorial-narcea:icaro-publisher-20.jpg,editorial-noveduc:icaro-publisher-21.png,editorial-nueva-vision:icaro-publisher-22.png,editorial-oberon:icaro-publisher-23.png,editorial-pepitas-de-calabaza:icaro-publisher-25.png,editorial-rialp:icaro-publisher-27.png,editorial-sans-soleil:icaro-publisher-28.png,editorial-sequitur:icaro-publisher-29.png,editorial-shangrila:icaro-publisher-30.png,editorial-siruela:icaro-publisher-31.png,editorial-tecnos:icaro-publisher-32.png,editorial-tinta-limon:icaro-publisher-33.png,editorial-visor:icaro-publisher-34.png,editorial-valdemar:icaro-publisher-36.png,editorial-contrasena:icaro-publisher-39.png,arpa-editores:icaro-publisher-40.png,editorial-barlin-libros:icaro-publisher-41.png,editorial-palinodia:icaro-publisher-42.png,editorial-rosameron:icaro-publisher-43.png,editorial-armaenia:icaro-publisher-44.png' | split: ',' -%}
<section class="icaro-logos" aria-labelledby="Logos-{{ section.id }}">
  <div class="page-width icaro-logos__head">
    <p class="icaro-eyebrow" id="Logos-{{ section.id }}">{{ section.settings.heading | escape }}</p>
    <a href="{{ section.settings.link | default: '/pages/editoriales-de-nuestra-distribucion' }}">Ver las {{ publisher_list.size }} editoriales →</a>
  </div>
  <div class="icaro-logos__viewport" data-icaro-marquee>
      <ul class="icaro-logos__track" role="list">
        {%- for entry in publisher_list -%}
          {%- assign parts = entry | split: ':' -%}
          {%- assign publisher = collections[parts[0]] -%}
          <li>
            <a href="{{ routes.collections_url }}/{{ parts[0] }}"title="{{ publisher.title | default: 'Editorial' | escape }}">
              <img src="{{ parts[1] | asset_url }}" alt="{{ publisher.title | default: 'Logo editorial' | escape }}" width="180" height="120" loading="lazy">
            </a>
          </li>
        {%- endfor -%}
      </ul>
  </div>
</section>
{% schema %}
{"name":"Ícaro · Logos editoriales","settings":[{"type":"text","id":"heading","label":"Título","default":"Editoriales que distribuimos en Colombia"},{"type":"url","id":"link","label":"Enlace a todas las editoriales"}],"presets":[{"name":"Ícaro · Logos editoriales"}]}
{% endschema %}
