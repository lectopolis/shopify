<section class="icaro-shelf" aria-labelledby="Shelf-{{ section.id }}">
  <div class="page-width">
    <div class="icaro-section-head"><div><p class="icaro-eyebrow">UNA ESTANTERÍA PARA EXPLORAR</p><h2 id="Shelf-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div><p>Elige una portada.<br>Descubre el libro que hay detrás.</p></div>
    <ul class="icaro-shelf__books" role="list" aria-label="Libros seleccionados">
      {% for block in section.blocks %}
        {% assign book = block.settings.book %}
        {% if book != blank %}
          {% render 'icaro-shelf-book', book: book, block: block, section_id: section.id %}
        {% elsif request.design_mode %}
          <li class="icaro-shelf__empty" {{ block.shopify_attributes }}>Selecciona un libro en este bloque.</li>
        {% endif %}
      {% endfor %}
      {% if section.blocks.size == 0 %}
        {% for book in section.settings.collection.products limit: section.settings.limit %}
          {% render 'icaro-shelf-book', book: book, section_id: section.id %}
        {% else %}
          {% if request.design_mode %}<li class="icaro-shelf__empty">Agrega hasta 18 bloques de libros o selecciona una colección de respaldo.</li>{% endif %}
        {% endfor %}
      {% endif %}
    </ul>
    <p class="icaro-shelf__hint">Toca una portada o selecciónala con el teclado para ver sus detalles. <a href="{{ routes.all_products_collection_url }}">Ver todo el catálogo →</a></p>
  </div>
</section>
{% schema %}
{"name":"Ícaro · Estantería","max_blocks":18,"settings":[{"type":"text","id":"heading","label":"Título","default":"En nuestra mesa de lectura"},{"type":"range","id":"limit","label":"Libros desde la colección","min":6,"max":18,"step":6,"default":18},{"type":"collection","id":"collection","label":"Colección de respaldo","info":"Se muestra solo si no hay bloques. Para una selección manual, agrega y reordena hasta 18 bloques."}],"blocks":[{"type":"book","name":"Libro","settings":[{"type":"product","id":"book","label":"Libro"}]}],"presets":[{"name":"Ícaro · Estantería"}]}
{% endschema %}
