<div class="lp-announcement">Libros nuevos y leídos <span aria-hidden="true">✳</span> Envíos nacionales <span aria-hidden="true">✳</span> Más de 15 años contigo</div>
<header class="lp-site-header">
  <a class="lp-brand" href="{{ routes.root_url }}" aria-label="Lectópolis, inicio">{% render 'lectopolis-logo' %}</a>
  <form class="lp-header-search" action="{{ routes.search_url }}" method="get" role="search">
    <input type="hidden" name="type" value="product">
    <label class="lp-sr-only" for="lp-header-search-{{ section.id }}">Buscar libros por título o autor</label>
    <input id="lp-header-search-{{ section.id }}" type="search" name="q" placeholder="Busca un libro o autor…" required>
    <button type="submit" aria-label="Buscar libros">{% render 'lectopolis-icon', icon: 'search' %}</button>
  </form>
  <nav class="lp-navigation" aria-label="Navegación principal">
    <a href="{{ routes.root_url }}"{% if request.path == routes.root_url %} aria-current="page"{% endif %}>Inicio</a>
    <a href="{{ routes.all_products_collection_url }}"{% if request.path == routes.all_products_collection_url %} aria-current="page"{% endif %}>Comprar libros</a>
    <a href="{{ routes.all_products_collection_url }}?sort_by=created-descending">Novedades</a>
    <a href="{{ routes.root_url }}#lp-nosotros">Nosotros</a>
    <a href="{{ routes.root_url }}#lp-contacto">Contacto</a>
  </nav>
  <div class="lp-header-actions"><a class="lp-header-whatsapp" href="https://wa.me/573136118658" target="_blank" rel="noopener">WhatsApp ↗</a><a id="cart-icon-bubble" class="lp-cart-link" href="{{ routes.cart_url }}" aria-label="Carrito">{% render 'lectopolis-icon', icon: 'bag' %}<span class="lp-cart-label">Carrito</span><span aria-hidden="true">{{ cart.item_count }}</span><span class="lp-sr-only">{{ cart.item_count }} artículos</span></a></div>
</header>
{% schema %}
{"name":"Lectópolis · Cabecera","settings":[]}
{% endschema %}
