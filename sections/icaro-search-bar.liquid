<style>{{ 'icaro-visible-search.css' | inline_asset_content }}</style>
<div class="page-width icaro-search-bar">
  {% if settings.predictive_search_enabled %}<predictive-search class="icaro-visible-search" data-visible-search="{{ section.id }}" data-loading-text="{{ 'accessibility.loading' | t }}">{% else %}<search-form class="icaro-visible-search">{% endif %}
  <form action="{{ routes.search_url }}" method="get" role="search">
    <label for="IcaroSearch-{{ section.id }}">Encuentra tu próxima lectura</label>
    <div class="icaro-visible-search__field">
      <input id="IcaroSearch-{{ section.id }}" type="search" name="q" placeholder="Título, autor o ISBN" value="{{ search.terms | escape }}" {% if settings.predictive_search_enabled %}role="combobox" aria-expanded="false" aria-controls="IcaroResults-{{ section.id }}" aria-haspopup="listbox" aria-autocomplete="list" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"{% endif %}>
      <button type="reset" class="icaro-visible-search__reset{% if search.terms == blank %} hidden{% endif %}" aria-label="{{ 'general.search.reset' | t }}">×</button>
      <button type="submit" class="icaro-visible-search__submit">Buscar <span aria-hidden="true">→</span></button>
    </div>
    <input type="hidden" name="type" value="product">
    <input type="hidden" name="options[prefix]" value="last">
    {% if settings.predictive_search_enabled %}
      <div id="IcaroResults-{{ section.id }}" class="predictive-search icaro-visible-search__results" tabindex="-1" data-predictive-search>
        {% render 'loading-spinner', class: 'predictive-search__loading-state' %}
      </div>
      <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
    {% endif %}
  </form>
  {% if settings.predictive_search_enabled %}</predictive-search>{% else %}</search-form>{% endif %}
</div>
{% schema %}
{"name":"Ícaro · Búsqueda visible","settings":[],"presets":[{"name":"Ícaro · Búsqueda visible"}]}
{% endschema %}
