<article class="lectopolis-blog-card">
  {% if show_image and article.image %}
    <a class="lectopolis-blog-card__image" href="{{ article.url }}" aria-label="Leer {{ article.title | escape }}">{{ article.image | image_url: width: 1200 | image_tag: widths: '360, 600, 900, 1200', sizes: '(min-width: 990px) 45vw, (min-width: 750px) 50vw, 100vw', loading: 'lazy', alt: article.title }}</a>
  {% endif %}
  <div class="lectopolis-blog-card__copy">
    <p class="lectopolis-blog-card__meta">{% if show_date %}{{ article.published_at | time_tag: format: 'date' }}{% endif %}{% if show_author %} · {{ article.author | escape }}{% endif %}</p>
    <h2><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
    <p class="lectopolis-blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 34 }}</p>
    <a class="lectopolis-blog-card__read" href="{{ article.url }}" aria-label="Leer artículo: {{ article.title | escape }}">Leer artículo <span aria-hidden="true">↗</span></a>
  </div>
</article>
