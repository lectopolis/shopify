{%- comment -%}
  json-ld-seo.liquid — Datos estructurados (Schema.org) para Ícaro Libros
  Genera: Organization/BookStore, WebSite, BreadcrumbList, Product+Book, Article.
  Instalar como: snippets/json-ld-seo.liquid
  Incluir en layout/theme.liquid antes de </head>:  {% render 'json-ld-seo' %}

  Datos del libro:
    - ISBN: se toma del campo "barcode" (codigo de barras) de la variante.
    - Autor: metafield product.metafields.custom.autor (si existe), si no, se omite.
    - Editorial: campo "vendor" (proveedor) del producto.
{%- endcomment -%}

{%- comment -%} ============ ORGANIZATION (BookStore) — solo en la portada ============ {%- endcomment -%}
{%- if request.page_type == 'index' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BookStore",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  {%- if settings.favicon != blank -%}
  "logo": {{ settings.favicon | image_url: width: 500 | prepend: "https:" | json }},
  {%- endif -%}
  "email": {{ shop.email | json }},
  "telephone": "+57 316 4810958",
  "currenciesAccepted": "COP",
  "legalName": "ICARO LIBROS DISTRIBUIDORA SAS",
  "foundingDate": "2002-01-24",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Calle 42 # 73-44",
    "addressLocality": "Medellín",
    "addressRegion": "Antioquia",
    "addressCountry": "CO"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 6.2483594,
    "longitude": -75.5927776
  },
  "hasMap": "https://www.google.com/maps/search/?api=1&query=6.2483594,-75.5927776",
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "09:00",
      "closes": "13:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "14:00",
      "closes": "17:00"
    }
  ],
  "areaServed": {
    "@type": "Country",
    "name": "Colombia"
  },
  "sameAs": [
    "https://www.instagram.com/icarolibros/",
    "https://www.facebook.com/icarolibrosoficial",
    "https://www.tiktok.com/@icarolibros"
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
</script>
{%- endif -%}

{%- comment -%} ============ BREADCRUMBS — producto y colección ============ {%- endcomment -%}
{%- if request.page_type == 'product' or request.page_type == 'collection' -%}
{%- liquid
  assign bc_name = product.title | split: ' - ' | first | strip
  assign bc_prefix = bc_name | slice: 0, 6
  if bc_prefix == 'Libro '
    assign bc_name = bc_name | slice: 6, 400 | strip
  endif
  if bc_name == blank
    assign bc_name = product.title
  endif
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": {{ shop.url | json }}
    }
    {%- if request.page_type == 'collection' -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ collection.title | json }},
      "item": "{{ shop.url }}{{ collection.url }}"
    }
    {%- elsif request.page_type == 'product' -%}
      {%- if collection -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ collection.title | json }},
      "item": "{{ shop.url }}{{ collection.url }}"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ bc_name | json }},
      "item": "{{ shop.url }}{{ product.url }}"
    }
      {%- else -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ bc_name | json }},
      "item": "{{ shop.url }}{{ product.url }}"
    }
      {%- endif -%}
    {%- endif -%}
  ]
}
</script>
{%- endif -%}

{%- comment -%} ============ PRODUCT + BOOK — página de producto ============ {%- endcomment -%}
{%- if request.page_type == 'product' and product -%}
{%- liquid
  assign isbn = product.selected_or_first_available_variant.barcode
  assign j_raw = product.description

  comment
    Titulo limpio y autor: mismo criterio que snippets/product-title.liquid
    (titulo "Nombre - Autor - Editorial"; autor de dos palabras viene como "Apellido Nombre").
  endcomment
  assign j_parts = product.title | split: ' - '
  assign j_name = j_parts[0] | strip
  for j_i in (1..2)
    assign j_prefix = j_name | slice: 0, 6
    if j_prefix == 'Libro '
      assign j_name = j_name | slice: 6, 400 | strip
    endif
  endfor
  if j_name == blank
    assign j_name = product.title
  endif

  assign autor = product.metafields.custom.autor | default: product.metafields.custom.author
  if autor == blank
    if j_parts.size == 2 or j_parts.size == 3
      assign autor = j_parts[1] | strip | replace: '  ', ' '
      assign j_autor_dn = autor | downcase
      assign j_vendor_dn = product.vendor | downcase | strip
      if j_autor_dn contains 'vv.aa' or j_autor_dn == j_vendor_dn
        assign autor = ''
      endif
      if autor != blank
        assign j_tokens = autor | split: ' '
        if j_tokens.size == 2
          assign autor = j_tokens[1] | append: ' ' | append: j_tokens[0]
        endif
      endif
    endif
  endif

  comment
    Año, tema y reseña salen del bloque de texto de la descripcion ("Año:", "Tema:", "Reseña del libro:").
  endcomment
  assign anio = ''
  assign j_anio = j_raw | split: 'Año:</strong> '
  if j_anio.size > 1
    assign anio = j_anio[1] | slice: 0, 4
    assign j_anio_n = anio | plus: 0
    if j_anio_n < 1000 or j_anio_n > 2100
      assign anio = ''
    endif
  endif
  assign genero = ''
  assign j_tema = j_raw | split: 'Tema:</strong> '
  if j_tema.size > 1
    assign genero = j_tema[1] | split: '<' | first | strip
  endif
  assign sinopsis = ''
  assign j_res = j_raw | split: 'Reseña del libro:</strong>'
  if j_res.size > 1
    assign sinopsis = j_res[1] | split: '</p>' | first | strip_html | strip_newlines | strip
  endif
  if sinopsis contains 'Sinopsis disponible' or sinopsis.size < 40
    assign sinopsis = ''
  endif
  capture j_desc
    if sinopsis != blank
      echo sinopsis | truncate: 300
    else
      echo 'Compra ' | append: j_name
      if autor != blank
        echo ' de ' | append: autor
      endif
      if product.vendor != blank
        echo ' (' | append: product.vendor | append: ')'
      endif
      echo ' en Colombia.'
      if isbn != blank
        echo ' ISBN ' | append: isbn | append: '.'
      endif
      echo ' Envíos a todo el país.'
    endif
  endcapture
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": ["Product", "Book"],
  "@id": "{{ shop.url }}{{ product.url }}#product",
  "name": {{ j_name | json }},
  "url": "{{ shop.url }}{{ product.url }}",
  "description": {{ j_desc | strip | json }},
  {%- if product.featured_image -%}
  "image": [
    {%- for image in product.images limit: 5 -%}
    {{ image | image_url: width: 1200 | prepend: "https:" | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  {%- endif -%}
  {%- if isbn != blank -%}
  "isbn": {{ isbn | json }},
  {%- assign isbn_digits = isbn | remove: '-' | remove: ' ' -%}
  {%- if isbn_digits.size == 13 -%}
  "gtin13": {{ isbn_digits | json }},
  {%- endif -%}
  {%- endif -%}
  {%- if product.selected_or_first_available_variant.sku != blank -%}
  "sku": {{ product.selected_or_first_available_variant.sku | json }},
  {%- endif -%}
  {%- if autor != blank -%}
  "author": {
    "@type": "Person",
    "name": {{ autor | json }}
  },
  {%- endif -%}
  {%- if product.vendor != blank -%}
  "publisher": {
    "@type": "Organization",
    "name": {{ product.vendor | json }}
  },
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | json }}
  },
  {%- endif -%}
  {%- if anio != blank -%}
  "datePublished": {{ anio | json }},
  {%- endif -%}
  {%- if genero != blank -%}
  "genre": {{ genero | json }},
  {%- endif -%}
  "inLanguage": "es",
  "bookFormat": "https://schema.org/Paperback",
  "offers": [
    {%- for variant in product.variants -%}
    {
      "@type": "Offer",
      "url": "{{ shop.url }}{{ product.url }}?variant={{ variant.id }}",
      "price": {{ variant.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "availability": "{% if variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
      "itemCondition": "https://schema.org/NewCondition",
      {%- if isbn != blank and variant.barcode != blank -%}
      "gtin13": {{ variant.barcode | remove: '-' | remove: ' ' | json }},
      {%- endif -%}
      "seller": {
        "@type": "Organization",
        "name": {{ shop.name | json }}
      }
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{%- comment -%} ============ ARTICLE — blog ============ {%- endcomment -%}
{%- if request.page_type == 'article' and article -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ article.title | json }},
  "url": "{{ shop.url }}{{ article.url }}",
  {%- if article.image -%}
  "image": {{ article.image | image_url: width: 1200 | prepend: "https:" | json }},
  {%- endif -%}
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "author": {
    "@type": "Person",
    "name": {{ article.author | json }}
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }}
  },
  "description": {{ article.excerpt_or_content | strip_html | truncate: 300 | json }}
}
</script>
{%- endif -%}
