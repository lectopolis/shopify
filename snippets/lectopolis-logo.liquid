{% comment %}Logo original recortado a su área visible (sin el margen blanco) y comprimido en WebP.{% endcomment %}
<span class="lp-logo-window{% if footer %} lp-logo-window--footer{% endif %}">
  <img src="{{ 'lectopolis-logo-520.webp' | asset_url }}" srcset="{{ 'lectopolis-logo-260.webp' | asset_url }} 260w, {{ 'lectopolis-logo-520.webp' | asset_url }} 520w" sizes="{% if footer %}250px{% else %}210px{% endif %}" width="520" height="245" alt="Librería Lectópolis — Amamos leer" loading="{% if footer %}lazy{% else %}eager{% endif %}" decoding="async">
</span>
