{%- comment -%}Libros de la vitrina 3D. Recibe books y limit.{%- endcomment -%}
{%- for book in books limit: limit -%}
  {%- assign variant = book.selected_or_first_available_variant -%}
  <li class="icaro-flow__item">
    <a class="icaro-flow__cover" href="{{ book.url }}" aria-label="{{ book.title | escape }}">
      {%- if book.featured_media -%}
        {{ book.featured_media | image_url: width: 400 | image_tag: widths: '240, 400', sizes: '(max-width: 749px) 150px, 210px', loading: 'lazy', alt: book.title }}
      {%- else -%}
        <span class="icaro-book__plain">{{ book.title | escape }}</span>
      {%- endif -%}
    </a>
    <div class="icaro-flow__info">
      <h3><a href="{{ book.url }}">{% render 'icaro-book-title', book: book %}</a></h3>
      <p class="icaro-flow__price">{% if book.price_varies %}Desde {% endif %}{{ book.price | money }}</p>
      {%- if book.has_only_default_variant and book.available and variant.quantity_rule.min == 1 and variant.quantity_rule.increment == 1 -%}
        <form action="{{ routes.cart_add_url }}" method="post" data-icaro-add>
          <input type="hidden" name="id" value="{{ variant.id }}"><input type="hidden" name="quantity" value="1">
          <button class="icaro-pill" type="submit" aria-label="Agregar {{ book.title | escape }} al carrito">Agregar <span aria-hidden="true">+</span></button>
          <p class="icaro-shelf__status" role="status" aria-live="polite"></p>
        </form>
      {%- elsif book.available == false -%}
        <p class="icaro-flow__soldout">Agotado</p>
      {%- endif -%}
    </div>
  </li>
{%- endfor -%}
