{{ 'icaro-about.css' | asset_url | stylesheet_tag }}
<div class="page-width icaro-about">
  <header class="icaro-about__hero">
    <div><p class="icaro-eyebrow">QUIÉNES SOMOS · ÍCARO LIBROS</p><h1>Distribuidores de libros.<br><em>Libreros de oficio.</em></h1><p class="icaro-about__lead">Acercamos editoriales selectas a librerías, bibliotecas y lectores en Colombia. Una oferta diversa, guiada por el conocimiento del libro y la atención personal.</p><a class="button" href="{{ pages['editoriales-de-nuestra-distribucion'].url | default: routes.all_products_collection_url }}">Conoce nuestra distribución ↗</a></div>
    <div class="icaro-about__identity"><img src="{{ 'icaro-about-brand.png' | asset_url }}" alt="Ícaro Libros" width="480" height="426" loading="eager"><p>Editoriales · Librerías · Lectores</p></div>
  </header>
  <section class="icaro-about__story" aria-labelledby="AboutStory-{{ section.id }}">
    <div><p class="icaro-eyebrow">NUESTRO OFICIO</p><h2 id="AboutStory-{{ section.id }}">Dar espacio a otras voces.</h2></div>
    <div><p>Proponemos una oferta editorial diversa en autores, editores y perspectivas. Facilitamos el encuentro con pensadores, críticos y poetas que no siempre tienen lugar en los escaparates y catálogos tradicionales.</p><p>Desde los clásicos hasta la vanguardia, exploramos la filosofía, la estética, la literatura y las ciencias humanas y sociales. Cultivamos con especial cuidado la poesía.</p></div>
  </section>
  <section class="icaro-about__principles" aria-label="Lo que guía nuestro trabajo">
    <article><span aria-hidden="true">01</span><h2>Selección editorial</h2><p>Catálogos con identidad y diversidad de pensamiento.</p></article>
    <article><span aria-hidden="true">02</span><h2>Distribución</h2><p>Un puente entre editoriales, librerías, instituciones y lectores.</p></article>
    <article><span aria-hidden="true">03</span><h2>Atención personal</h2><p>Conversamos sobre títulos, disponibilidad y condiciones de cada pedido.</p></article>
  </section>
  <section class="icaro-about__contact" aria-labelledby="AboutContact-{{ section.id }}">
    <div><p class="icaro-eyebrow">ESTAMOS EN MEDELLÍN</p><h2 id="AboutContact-{{ section.id }}">Hablemos de libros.</h2><a class="button" href="https://wa.me/573164810958?text=Hola%2C%20quisiera%20conocer%20m%C3%A1s%20sobre%20%C3%8Dcaro%20Libros.">Conversar por WhatsApp ↗</a></div>
    <div class="icaro-about__contact-details"><div><h3>Visítanos</h3><p>Laureles · Calle 42 # 73-44<br>Medellín, Colombia</p></div><div><h3>Horario</h3><p>Lunes a viernes<br>9:00 a. m. – 1:00 p. m.<br>2:00 p. m. – 5:00 p. m.</p></div><div><h3>Contacto comercial</h3><a href="mailto:ventas@icarolibros.com">ventas@icarolibros.com</a><br><a href="tel:+573164810958">+57 316 481 0958</a></div></div>
  </section>
  {%- liquid
    assign icaro_store_address = 'Calle 42 # 73-44, Laureles, Medellín, Colombia'
    assign icaro_store_address_encoded = icaro_store_address | url_encode
    assign icaro_maps_embed_url = 'https://www.google.com/maps?q=' | append: icaro_store_address_encoded | append: '&output=embed'
    assign icaro_maps_directions_url = 'https://www.google.com/maps/dir/?api=1&destination=' | append: icaro_store_address_encoded
    assign icaro_waze_url = 'https://waze.com/ul?q=' | append: icaro_store_address_encoded | append: '&navigate=yes'
  -%}
  <section class="icaro-about__map" aria-labelledby="AboutMap-{{ section.id }}">
    <p class="icaro-eyebrow">CÓMO LLEGAR</p>
    <h2 id="AboutMap-{{ section.id }}">Visítanos en Laureles.</h2>
    <div class="icaro-about__map-frame">
      <iframe
        src="{{ icaro_maps_embed_url }}"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Mapa de ubicación de Ícaro Libros en Laureles, Medellín"
        aria-hidden="true"
        tabindex="-1"
      ></iframe>
      <a
        class="icaro-about__map-link"
        href="{{ icaro_maps_directions_url }}"
        data-waze-url="{{ icaro_waze_url }}"
        target="_blank"
        rel="noopener"
      >
        <span class="icaro-about__map-pin" aria-hidden="true">📍</span>
        <span class="icaro-about__map-link-text">
          <strong>Ícaro Libros</strong>
          <small class="icaro-about__map-link-text--mobile">Toca para abrir en Waze</small>
          <small class="icaro-about__map-link-text--desktop">Cómo llegar en Google Maps <span aria-hidden="true">↗</span></small>
        </span>
      </a>
    </div>
  </section>
</div>
