{%- comment -%}
  Libro 3D con portada, lomo, cantos de páginas y contraportada.
  - book: producto
  - width: ancho de la portada en px (por defecto 260)
  - eager: true para la imagen principal sobre el pliegue
  - sizes: atributo sizes opcional
{%- endcomment -%}
{%- liquid
  assign cover = book.featured_media
  assign back = book.media[1]
  assign book_width = width | default: 260
  assign img_sizes = sizes | default: '260px'
  assign ratio = 0.68
  if cover
    assign ratio = cover.aspect_ratio | at_least: 0.6 | at_most: 0.85
  endif
  assign spine_src = ''
  if cover
    assign spine_src = cover | image_url: width: 240
  endif
-%}
<div class="icaro-book" style="--w:{{ book_width }}px;--ar:{{ ratio }};{% if spine_src != '' %}--spine:url('{{ spine_src }}');{% endif %}">
  <div class="icaro-book__face icaro-book__front">
    {%- if cover -%}
      {%- if eager -%}
        {{ cover | image_url: width: 720 | image_tag: widths: '260, 360, 520, 720', sizes: img_sizes, loading: 'eager', fetchpriority: 'high', alt: book.title, draggable: 'false' }}
      {%- else -%}
        {{ cover | image_url: width: 720 | image_tag: widths: '260, 360, 520, 720', sizes: img_sizes, loading: 'lazy', alt: book.title, draggable: 'false' }}
      {%- endif -%}
    {%- else -%}
      <span class="icaro-book__plain">{{ book.title | escape }}</span>
    {%- endif -%}
    <span class="icaro-book__gloss" aria-hidden="true"></span>
  </div>
  <div class="icaro-book__face icaro-book__spine" aria-hidden="true"></div>
  <div class="icaro-book__face icaro-book__pages" aria-hidden="true"></div>
  <div class="icaro-book__face icaro-book__top" aria-hidden="true"></div>
  <div class="icaro-book__face icaro-book__back" aria-hidden="true">
    {%- if back and back.media_type == 'image' -%}
      {{ back | image_url: width: 520 | image_tag: widths: '260, 360, 520', sizes: img_sizes, loading: 'lazy', alt: '', draggable: 'false' }}
    {%- else -%}
      <span class="icaro-book__plain icaro-book__plain--back"><small>{{ book.vendor | escape }}</small>{% render 'icaro-book-title', book: book %}<em>Ícaro Libros</em></span>
    {%- endif -%}
  </div>
</div>
