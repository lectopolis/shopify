{{ 'icaro-publishers.css' | asset_url | stylesheet_tag }}
<div class="icaro-publishers page-width">
  <header class="icaro-publishers__hero">
    <div><p class="icaro-eyebrow">ÍCARO LIBROS · DISTRIBUCIÓN EDITORIAL EN COLOMBIA</p><h1>{{ section.settings.heading | default: 'Editoriales con identidad. Libros que conectan.' | escape }}</h1><p class="icaro-publishers__intro">{{ section.settings.text | default: 'Distribuimos en Colombia libros de editoriales de España y Argentina. Filosofía, literatura, poesía y ciencias humanas: catálogos para librerías, instituciones y lectores que buscan nuevas perspectivas.' | escape }}</p><a href="#PublisherDirectory-{{ section.id }}" class="button">Explorar editoriales <span aria-hidden="true">↓</span></a></div>
    <div class="icaro-publishers__manifesto"><span aria-hidden="true">Í</span><p>De las editoriales<br>a las librerías.<br>De los libros<br>a los lectores.</p><small>España · Argentina · Colombia</small></div>
  </header>
  <div class="icaro-publishers__directory-head" id="PublisherDirectory-{{ section.id }}"><h2>Editoriales de nuestra distribución</h2><p>Explora sus especialidades y encuentra los libros de cada catálogo.</p></div>
  <div class="icaro-publishers__grid">{% render 'icaro-publisher-directory' %}</div>
  <aside class="icaro-publishers__contact" aria-labelledby="PublisherContact-{{ section.id }}"><div><p class="icaro-eyebrow">ATENCIÓN COMERCIAL</p><h2 id="PublisherContact-{{ section.id }}">¿Buscas un título o un catálogo?</h2><p>Si no encuentras un libro de las editoriales que distribuimos, consulta con nuestro equipo. Para librerías e instituciones, conversemos sobre disponibilidad, cantidades y condiciones comerciales.</p></div><div class="icaro-publishers__contact-links"><a class="button" href="https://wa.me/573164810958?text=Hola%2C%20quisiera%20consultar%20las%20editoriales%20que%20distribuyen.">Consultar con ventas ↗</a><a href="mailto:ventas@icarolibros.com">ventas@icarolibros.com</a></div></aside>
</div>
