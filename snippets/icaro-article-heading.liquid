{%- assign reading_minutes = article.content | strip_html | split: ' ' | size | divided_by: 200 | at_least: 1 -%}
<div class="icaro-premium-content">
  <header class="icaro-reading__header">
    <nav class="icaro-reading__breadcrumb" aria-label="Ruta de navegación"><a href="{{ routes.root_url }}">Inicio</a><span aria-hidden="true"> / </span><a href="{{ blog.url }}">{{ blog.title | escape }}</a></nav>
    <div class="icaro-reading__meta">{{ article.published_at | date: '%d/%m/%Y' }} · {{ reading_minutes }} min de lectura</div>
    <h1 class="icaro-reading__title">{{ article.title | escape }}</h1>
    {%- if article.excerpt != blank -%}<div class="icaro-reading__excerpt">{{ article.excerpt }}</div>{%- endif -%}
    <div class="icaro-reading__byline">Por <strong>{{ article.author | escape }}</strong></div>
  </header>
</div>
