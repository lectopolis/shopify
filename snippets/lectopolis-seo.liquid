{%- liquid
  assign seo_description = page_description | default: shop.description
  if request.page_type == 'index'
    assign seo_description = 'Librería Lectópolis: libros nuevos y leídos, más de 15 años de trayectoria y envíos nacionales. Encuentra tu próxima historia favorita.'
  endif
-%}
<meta name="description" content="{{ seo_description | escape }}">
<meta property="og:site_name" content="Lectópolis">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ page_title | escape }} | Lectópolis">
<meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
<meta property="og:description" content="{{ seo_description | escape }}">
{% if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}"><meta name="twitter:card" content="summary_large_image">{% endif %}
{% if request.page_type == 'index' %}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BookStore","name":"Librería Lectópolis","telephone":"+57 313 6118658","url":{{ shop.url | json }},"sameAs":["https://www.instagram.com/librerialectopolis/"]}</script>
{% endif %}
