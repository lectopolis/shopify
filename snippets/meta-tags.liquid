{%- liquid
  assign seo_description = page_description

  comment
    Fichas de producto sin descripcion SEO propia: en vez del texto del cuerpo, se arma una
    descripcion con titulo limpio, autor (si viene en el titulo o en custom.autor), editorial e ISBN.
    Las fichas que ya tienen descripcion SEO (global.description_tag) no se tocan.
  endcomment
  if request.page_type == 'product' and product.metafields.global.description_tag == blank
    assign pd_parts = product.title | split: ' - '
    assign pd_name = pd_parts[0] | strip
    for pd_i in (1..2)
      assign pd_prefix = pd_name | slice: 0, 6
      if pd_prefix == 'Libro '
        assign pd_name = pd_name | slice: 6, 400 | strip
      endif
    endfor
    assign pd_name = pd_name | replace: '  ', ' ' | truncate: 85

    assign pd_author = product.metafields.custom.autor.value | strip
    if pd_author == blank and pd_parts.size == 3
      assign pd_tokens = pd_parts[1] | strip | split: ' '
      if pd_tokens.size == 2
        assign pd_author = pd_tokens[1] | append: ' ' | append: pd_tokens[0]
      endif
    endif

    assign pd_vendor = product.vendor | strip
    assign pd_vendor_up = pd_vendor | upcase
    if pd_vendor == pd_vendor_up
      assign pd_vendor = pd_vendor | downcase | capitalize
    endif
    assign pd_isbn = product.selected_or_first_available_variant.barcode | strip

    assign pd_tail = ''
    if pd_isbn != blank
      assign pd_tail = ' ISBN ' | append: pd_isbn | append: '.'
    endif
    assign pd_tail = pd_tail | append: ' Envíos a todo el país.'

    assign pd_vendor_txt = ''
    if pd_vendor != blank
      assign pd_vendor_txt = ' (' | append: pd_vendor | append: ')'
    endif
    assign pd_author_txt = ''
    if pd_author != blank
      assign pd_author_txt = ' de ' | append: pd_author
    endif

    assign seo_description = 'Compra ' | append: pd_name | append: pd_author_txt | append: pd_vendor_txt | append: ' en Colombia.' | append: pd_tail
    if seo_description.size > 158
      assign seo_description = 'Compra ' | append: pd_name | append: pd_vendor_txt | append: ' en Colombia.' | append: pd_tail
    endif
    if seo_description.size > 158
      assign seo_description = 'Compra ' | append: pd_name | append: ' en Colombia.' | append: pd_tail
    endif
    assign pd_with_brand = seo_description | append: ' Ícaro Libros, distribuidora de libros.'
    if pd_with_brand.size <= 158
      assign seo_description = pd_with_brand
    endif
  endif

  comment
    Carrito y politicas no traen descripcion propia y caian en shop.description (la misma del inicio),
    lo que genera metadescripciones duplicadas. Cada una recibe la suya.
  endcomment
  if seo_description == blank
    case request.path
      when '/cart'
        assign seo_description = 'Revisa los libros de tu carrito en Ícaro Libros y continúa con la compra. Envíos a todo el país.'
      when '/policies/privacy-policy'
        assign seo_description = 'Política de privacidad de Ícaro Libros: qué datos personales recogemos cuando compras en icarolibros.com y cómo los usamos.'
      when '/policies/refund-policy'
        assign seo_description = 'Política de reembolso de Ícaro Libros: condiciones para devoluciones, cambios y reembolsos de los libros que compras con nosotros.'
      when '/policies/shipping-policy'
        assign seo_description = 'Política de envío de Ícaro Libros: cómo despachamos tus libros desde Medellín y qué debes saber sobre los envíos.'
      when '/policies/terms-of-service'
        assign seo_description = 'Términos del servicio de Ícaro Libros, distribuidora de libros en Colombia: condiciones de uso del sitio y de compra.'
    endcase
  endif

  assign og_title = page_title | default: shop.name
  if request.page_type == 'index'
    assign og_title = 'Ícaro Libros | Distribuidora de libros en Colombia'
  endif
  if request.page_type == 'product'
    capture pd_og_title
      render 'product-title'
    endcapture
    assign pd_og_title = pd_og_title | strip
    if pd_og_title != blank
      assign og_title = pd_og_title
    endif
  endif
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = seo_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  assign og_image_alt = og_title
  if page_image.alt != blank
    assign og_image_alt = page_image.alt
  endif
-%}

{%- comment -%} Meta robots: noindex en páginas de paginación para evitar contenido duplicado {%- endcomment -%}
{%- if current_page > 1 -%}
  <meta name="robots" content="noindex, follow">
{%- endif -%}

{%- comment -%} Meta description explícita {%- endcomment -%}
{%- if seo_description != blank -%}
  <meta name="description" content="{{ seo_description | escape }}">
{%- elsif shop.description != blank -%}
  <meta name="description" content="{{ shop.description | escape }}">
{%- endif -%}

{%- comment -%} Open Graph {%- endcomment -%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape_once }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:locale" content="{{ request.locale.iso_code | replace: '-', '_' }}">

{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: page_image.aspect_ratio | round }}">
  <meta property="og:image:alt" content="{{ og_image_alt | escape_once }}">
  <meta property="og:image:type" content="image/jpeg">
{%- elsif settings.share_image != blank -%}
  <meta property="og:image" content="https:{{ settings.share_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ settings.share_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: settings.share_image.aspect_ratio | round }}">
  <meta property="og:image:alt" content="{{ shop.name | escape }}">
  <meta property="og:image:type" content="image/jpeg">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="product:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
  <meta property="product:condition" content="new">
  <meta property="product:brand" content="{{ product.vendor | escape }}">
{%- endif -%}

{%- comment -%} Twitter / X Card {%- endcomment -%}
{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape_once }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if page_image -%}
  <meta name="twitter:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta name="twitter:image:alt" content="{{ og_image_alt | escape_once }}">
{%- elsif settings.share_image != blank -%}
  <meta name="twitter:image" content="https:{{ settings.share_image | image_url: width: 1200 }}">
  <meta name="twitter:image:alt" content="{{ shop.name | escape }}">
{%- endif -%}

{%- comment -%} Paginación: rel prev/next para SEO {%- endcomment -%}
{%- if paginate.previous.url -%}
  <link rel="prev" href="{{ paginate.previous.url }}">
{%- endif -%}
{%- if paginate.next.url -%}
  <link rel="next" href="{{ paginate.next.url }}">
{%- endif -%}
