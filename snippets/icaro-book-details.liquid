<div class="icaro-book-details">
  {% if book.metafields.custom.autor != blank %}<p><strong>Autor:</strong> {{ book.metafields.custom.autor | escape }}</p>{% endif %}
  {% if book.selected_or_first_available_variant.barcode != blank %}<p><strong>ISBN / código de barras:</strong> {{ book.selected_or_first_available_variant.barcode | escape }}</p>{% endif %}
  <p>El costo y las opciones de envío se calculan al finalizar la compra.</p>
  {% if shop.shipping_policy != blank %}<p><a href="{{ shop.shipping_policy.url }}">Condiciones de envío</a></p>{% endif %}
  {% if shop.refund_policy != blank %}<p><a href="{{ shop.refund_policy.url }}">Condiciones de devolución</a></p>{% endif %}
  <a href="https://www.instagram.com/librerialectopolis/" target="_blank" rel="noopener">Consulta con Lectópolis en Instagram ↗</a>
</div>
